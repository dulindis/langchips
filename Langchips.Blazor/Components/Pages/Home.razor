@page "/"
@using Microsoft.AspNetCore.Components

<PageTitle>Home</PageTitle>

<!-- Top Navbar -->
<header class="navbar navbar-expand-lg navbar-light bg-primary">
    <div class="container-fluid">
        <!-- Placeholder logo -->
        <a class="navbar-brand" href="#">
            <img src="https://via.placeholder.com/150x50?text=Logo" alt="Logo" />
        </a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="navbarNav">
            <ul class="navbar-nav ms-auto">
                <li class="nav-item">
                    <a class="nav-link text-white" href="/about">About</a>
                </li>
                <li class="nav-item">
                    <button class="btn btn-light" @onclick="OnLoginClick">Login</button>
                </li>
            </ul>
        </div>
    </div>
</header>

<main class="container mt-5 text-center">
    <h2 class="display-4 mb-4">Do you want to study with us?</h2>
    <button class="btn btn-primary btn-lg" @onclick="GoToSignUp">Sign Up for Free</button>
    <p class="mt-4">If you already have an account, <button class="btn btn-link" @onclick="GoToSignIn">Sign In</button></p>
</main>

@code {
    [Inject] private NavigationManager NavigationManager { get; set; }

    private void OnLoginClick()
    {
        // Handle login action (could be a redirect or modal)
        Console.WriteLine("Login button clicked");
    }

    private void GoToSignUp()
    {
        // Navigate to the SignUp page
        NavigationManager.NavigateTo("/sign-up");
    }

    private void GoToSignIn()
    {
        // Navigate to the SignIn page
        NavigationManager.NavigateTo("/sign-in");
    }
}
